<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PocketShell declares only what it truly needs (brief §22):
        - INTERNET (M2.2): the Linux-environment installer downloads the pinned
          Alpine minirootfs over HTTPS from dl-cdn.alpinelinux.org and verifies
          its SHA-256 before use. No other network use; no third-party endpoints.
        - ACCESS_NETWORK_STATE (M2.4): reads the device's own DNS resolvers
          (ConnectivityManager LinkProperties) so the guest's /etc/resolv.conf
          points at servers that actually work on this network — hardcoded
          public resolvers were unreachable on the user's carrier network.
          Normal, install-time permission; no network traffic is triggered.
        - FOREGROUND_SERVICE(_SPECIAL_USE): keep real terminal sessions alive
          while the app is backgrounded (brief §24). The service stops itself
          when the last session closes.
        - POST_NOTIFICATIONS: lets the session-retention notification be seen
          on Android 13+ (service runs regardless; notification is hidden if
          the user has not granted this).
      No storage, no contacts — nothing else.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PocketShellApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketShell">

        <!--
          configChanges: the terminal must survive rotation/resize/fold without
          Activity recreation (brief §24). Session state additionally lives in a
          process-scoped manager, so even recreation cannot destroy sessions.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          m4.0.12: the render-baseline harness Activity was retired with the
          finalization pass (the frozen renderer needs no control anymore);
          the sweep's evidence lives in docs/RENDER-RESET-M4.0.9.md and the
          git history.
        -->

        <service
            android:name=".terminal.TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-launched terminal session processes alive while the app is backgrounded." />
        </service>
    </application>
</manifest>
