<?xml version="1.0" encoding="utf-8"?>
<!--
  M8.1 — network security config (docs/TESTING.md §65).

  Cleartext HTTP stays DENIED platform-wide (the targetSdk 28 default,
  now explicit): every remote companion site and the runtime installer
  are HTTPS-only, unchanged.

  The ONE exception is the device LOOPBACK (127.0.0.1 / localhost): the
  Linux guest and the app share a network namespace (proot creates no
  netns), so a dev server started in the guest — `npm run dev`,
  `python3 -m http.server` — listens on the device's own loopback. The
  Servers widget's "Open in Companion" action loads exactly that address
  in the Companion WebView; without this exception Android blocks the
  load with net::ERR_CLEARTEXT_NOT_PERMITTED (device-verified).

  Loopback traffic never leaves the device and terminates in the app's
  own UID's processes, so the exception exposes nothing to the network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
